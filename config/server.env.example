#!/usr/bin/env bash
# Copy this file to server.env and edit for the specific server.
# server.env is gitignored on purpose — it may contain a password.

# --- User ---------------------------------------------------------------
NEW_USER="deploy"

# Leave blank to be prompted interactively when the script runs
# (recommended — avoids putting a plaintext password in this file).
NEW_USER_PASSWORD=""

# Path to a public key to install for NEW_USER, in addition to copying
# root's authorized_keys if present. Leave blank to skip.
NEW_USER_PUBKEY_FILE=""

# --- SSH ------------------------------------------------------------------
# Port is intentionally not configurable here — kept on 22.
# Changing it is log hygiene, not a real security control, and it's easy
# to lock yourself out on Ubuntu 24.04 where ssh.socket owns the port.

# --- Firewall ---------------------------------------------------------------
# Extra TCP ports to allow through UFW, beyond 22 (always allowed).
# Space-separated. Leave empty if this box isn't serving anything yet.
ALLOWED_TCP_PORTS="80 443"

# --- System -----------------------------------------------------------------
TIMEZONE="Etc/UTC"

# --- Docker -------------------------------------------------------------
INSTALL_DOCKER="true"
